# HashiBot browser Supabase URL override. Highest priority; must point at HashiBot project.
VITE_HASHIBOT_SUPABASE_URL=https://uqiwbzfcntlcyyeewafc.supabase.co

# Optional public URL alias. Second priority; must point at HashiBot project.
VITE_PUBLIC_SUPABASE_URL=https://uqiwbzfcntlcyyeewafc.supabase.co

# Optional legacy URL. The app only accepts this when it matches the expected project ref.
VITE_SUPABASE_URL=https://uqiwbzfcntlcyyeewafc.supabase.co

# Browser-safe public key priority:
# 1. VITE_HASHIBOT_SUPABASE_ANON_KEY
# 2. VITE_SUPABASE_ANON_KEY
# 3. VITE_PUBLIC_SUPABASE_ANON_KEY
# 4. VITE_SUPABASE_PUBLISHABLE_KEY
# 5. VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Never put service-role keys, Supabase secret keys, database URLs, JWT/JWKS secrets,
# Telegram tokens, cron secrets, MT5 secrets, or backend private secrets in Vite/browser env.
VITE_HASHIBOT_SUPABASE_ANON_KEY=your-anon-public-jwt
VITE_SUPABASE_ANON_KEY=your-anon-public-jwt
# VITE_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-jwt
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
