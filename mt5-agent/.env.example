# HashiBot MT5 Agent Configuration Example
# Copy this file to .env and fill in your values

# Supabase Project Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
# Preferred restricted credential; temporary local fallback is shown below.
MT5_BRIDGE_TOKEN=replace-with-at-least-32-random-characters
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Unique MT5 Bridge Identification
BRIDGE_ID=bridge-mt5-001
MT5_ACCOUNT_ID=canonical-account-uuid
MT5_OWNER_ID=canonical-owner-uuid
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_DATA_PATH=C:\Users\you\AppData\Roaming\MetaQuotes\Terminal\INSTANCE_ID
MT5_PORTABLE=false

# Polling & Heartbeat Intervals (Seconds)
POLL_INTERVAL_SECONDS=2.0
HEARTBEAT_INTERVAL_SECONDS=10.0
STATE_SYNC_INTERVAL_SECONDS=5.0
SYMBOL_SYNC_INTERVAL_SECONDS=300.0
MARKET_DATA_INTERVAL_SECONDS=30.0

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Never configure ACCOUNT_NUMBER, PASSWORD, or an encryption key here. Normal
# mode supports one local account; production multi-account uses isolated
# portable terminals and data directories (MT5_PORTABLE=true).
