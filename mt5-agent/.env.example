# HashiBot MT5 Agent Configuration Example
# Copy this file to .env and fill in your values

# Supabase Project Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Unique MT5 Bridge Identification
BRIDGE_ID=bridge-mt5-001

# Polling & Heartbeat Intervals (Seconds)
POLL_INTERVAL_SECONDS=2.0
HEARTBEAT_INTERVAL_SECONDS=10.0
STATE_SYNC_INTERVAL_SECONDS=5.0
SYMBOL_SYNC_INTERVAL_SECONDS=300.0

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Direct MT5 Terminal Executable Path (if multiple MT5 terminals are installed)
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Optional: Account credentials for automatic login on startup
# ACCOUNT_NUMBER=12345678
# PASSWORD=your-mt5-password
# SERVER=YourBroker-Demo
