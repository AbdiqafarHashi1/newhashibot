{
  "name": "hashibot-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && npm run test:contracts && npm run test:execution",
    "test:contracts": "rm -rf .tmp && tsc -p tsconfig.json --outDir .tmp && find .tmp/tests -name \"*.test.js\" -print -exec node --test {} +",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:execution": "rm -rf .tmp && tsc -p tsconfig.json --outDir .tmp && find .tmp/tests/execution -name \"*.test.js\" -print -exec node --test {} +"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  }
}
