{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["shared/**/*.ts", "services/**/*.ts", "tests/**/*.ts", "adapters/**/*.ts", "shadow/**/*.ts", "runtime/**/*.ts"]
}
